# libFuzzer dictionary for fuzz_compile: jq 1.8.1's keywords, operators,
# syntax and builtins (`jq -nr '[builtins[]|split("/")[0]]|unique[]'`).
#   cargo +nightly fuzz run fuzz_compile -s none -- -dict=fuzz/dict/jq.dict ...

# Keywords.
"def"
"as"
"if"
"then"
"elif"
"else"
"end"
"reduce"
"foreach"
"try"
"catch"
"label"
"break"
"import"
"include"
"module"
"and"
"or"
"not"
"__loc__"

# Operators and punctuation.
"|"
","
"."
".."
"?"
"?//"
"//"
"//="
"="
"|="
"+="
"-="
"*="
"/="
"%="
"=="
"!="
"<"
"<="
">"
">="
"+"
"-"
"*"
"/"
"%"
":"
";"
"("
")"
"["
"]"
"{"
"}"
"[]"
"{}"
".[]"
".[]?"
".a"
".a.b"
".[0]"
".[-1]"
".[1:]"
".[:2]"
".[1:2]"
"$"
"$x"
"$ENV"
"$ARGS"
"$__loc__"
"$__prog_args"
"$__"
"@"
"\x22"
"\x5c("
"\x5c\x22"
"\x5cn"
"\x5cu00e9"
"\x5cud83d\x5cude00"
"#"
"\x0a"

# Literals.
"null"
"true"
"false"
"0"
"-0"
"1"
"1.0"
"1.5"
"1e1000"
"-1e1000"
"100000000000000000001"
"nan"
"infinite"
"\x22\x22"
"\x22a\x22"

# Formats.
"@text"
"@json"
"@html"
"@uri"
"@urid"
"@csv"
"@tsv"
"@sh"
"@base64"
"@base64d"
"@base32"
"@base32d"

# Syntax fragments.
"def f: "
"def f(g): "
"def f($a): "
"def f(g; $a): "
"as $x | "
"as [$a, $b] | "
"as {a: $a} | "
"as {$a} | "
"as [$a] ?// $a | "
"reduce .[] as $x (0; . + $x)"
"foreach .[] as $x (0; . + 1; .)"
"foreach .[] as $x (0; . + 1)"
"if . then 1 else 2 end"
"if . then 1 elif . then 2 end"
"try error catch ."
"label $out | "
"break $out"
"import \x22a\x22 as a; "
"import \x22a\x22 as $a; "
"include \x22a\x22; "
"module {}; "
"{a: 1}"
"{\x22a\x22: 1}"
"{(.a): 1}"
"{$x}"
"{a}"
"{@base64: 1}"
"\x22\x5c(.)\x22"
"?//"
"..|"
"path(..)"
"getpath([\x22a\x22])"
"$__loc__.line"
"input_line_number"
"ltrimstr(\x22a\x22)"
"limit(1; .[])"
"first(.[])"
"splits(\x22a\x22)"
"test(\x22a\x22; \x22gx\x22)"
"sub(\x22(?<x>a)\x22; \x22\x5c(.x)\x22)"

