# libFuzzer dictionary for the JSON targets (fuzz_parse, fuzz_dom,
# fuzz_io_reader, fuzz_tape): JSON's tokens, jq's extensions, and what
# simdjson's kernels handle in their own ways (escapes, UTF-8, numbers).
#   cargo +nightly fuzz run fuzz_dom -s none -- -dict=fuzz/dict/json.dict ...

# Structure.
"{"
"}"
"["
"]"
":"
","
"{}"
"[]"
"{\x22a\x22:"
"[[[[[[[["
"]]]]]]]]"

# Literals.
"true"
"false"
"null"
"nul"
"tru"
"nan"
"NaN"
"-nan"
"Infinity"
"-Infinity"

# Strings and escapes.
"\x22"
"\x22\x22"
"\x5c"
"\x5c\x22"
"\x5c\x5c"
"\x5c/"
"\x5cb"
"\x5cf"
"\x5cn"
"\x5cr"
"\x5ct"
"\x5cu"
"\x5cu0000"
"\x5cu001f"
"\x5cu00e9"
"\x5cuffff"
"\x5cud800"
"\x5cudc00"
"\x5cud83d\x5cude00"
"\x5cx"

# UTF-8, valid and not.
"\xc3\xa9"
"\xe2\x82\xac"
"\xf0\x9f\x98\x80"
"\xf4\x8f\xbf\xbf"
"\xef\xbb\xbf"
"\xc0\xaf"
"\xc3"
"\xe2\x82"
"\xed\xa0\x80"
"\xf4\x90\x80\x80"
"\x80"
"\xff"

# Numbers.
"0"
"-0"
"-"
"."
"e"
"E"
"e+"
"E-"
"0.5"
"1e2"
"1E+2"
"1e-400"
"1e400"
"9007199254740993"
"9223372036854775807"
"9223372036854775808"
"-9223372036854775809"
"18446744073709551615"
"18446744073709551616"
"1.7976931348623157e308"
"2.2250738585072014e-308"
"4.9e-324"
"100000000000000000000000000001"
"01"

# Whitespace and separators (NDJSON, --seq).
" "
"\x09"
"\x0a"
"\x0d\x0a"
"\x0a\x0a"
"\x1e"
"\x00"
